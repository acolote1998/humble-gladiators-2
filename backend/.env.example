# Clerk Configuration
CLERK_ISSUER_URL= your clerk issuer URL

# Database Configuration
JDBC_DATABASE_URL=jdbc:postgresql://localhost:5432/humble-gladiators-2-live-db
JDBC_DATABASE_USERNAME=aki
JDBC_DATABASE_PASSWORD=akipassword

# JPA Configuration
JPA_DDL_AUTO=create-drop
JPA_SHOW_SQL=false
DEFER_DATASOURCE_INITIALIZATION=true
SQL_INIT_MODE=always

# Application Configuration
APP_BASE_URL=http://localhost:8080

# RUNWARE

RUNWARE_IMG_GEN_URL=https://api.runware.ai/v1/image-inference
RUNWARE_API_KEY=

# GEMINI Key
GEMINI_API_KEY=your api key

# Server Configuration (optional)
SERVER_PORT=8080

GAME_CREATION_STATE_INTERVAL=500

# Booster Configuration

UNLIMITED_BOOSTERS_ALLOWED=true

# Battle Configuration
UNLIMITED_BATTLES_ALLOWED=true

# Inventory Configuration

SKIP_REQUIREMENTS=true

# Content Generation Configuration
GENERATE_IMAGES=true
GENERATE_CAMPAIGN_COVER=true
GENERATE_CAMPAIGN_CARD_BACK=true

GENERATE_ALL=true

GENERATE_NPCS=false
GENERATE_ARMORS=false
GENERATE_BOOTS=false
GENERATE_CONSUMABLES=false
GENERATE_HELMETS=false
GENERATE_SHIELDS=false
GENERATE_SPELLS=false
GENERATE_WEAPONS=false

# Balance Configuration

    # When we draw an NPC from a booster, there is a % chance defined below of them obtaining an item
    # This runs one time for each item type, 3 times for spells and 3 times for consumables
NPC_ITEM_GENERATION_CHANCE=50

    # % chance of an item to be dropped from a defeated enemy. This % is independent for every item in enemy's inventory
NPC_ITEM_DROP_CHANCE=50

    # Amount of cards to draw per character booster
AMOUNT_OF_CARDS_PER_CHARACTER_BOOSTER=10
    # Amount of cards to draw per item booster
AMOUNT_OF_CARDS_PER_ITEM_BOOSTER=10

    # Rarity and Tier % of the cards when opening a booster.
        # All rarities chances must add up to 100
CARD_RARITY_ONE_CHANCE=20
CARD_RARITY_TWO_CHANCE=20
CARD_RARITY_THREE_CHANCE=20
CARD_RARITY_FOUR_CHANCE=20
CARD_RARITY_FIVE_CHANCE=20
        # All tiers chances must add up to 100
CARD_TIER_ONE_CHANCE=20
CARD_TIER_TWO_CHANCE=20
CARD_TIER_THREE_CHANCE=20
CARD_TIER_FOUR_CHANCE=20
CARD_TIER_FIVE_CHANCE=20

    # Minimum stat allowed (strength, dexterity, etc)
MINIMUM_STAT_VALUE=0
    # Maximum stat allowed (strength, dexterity, etc)
MAXIMUM_STAT_VALUE=100

    # Used when generating stats for a character.
CONSTITUTION_HP_MODIFIER=50
    # Used when generating stats for a character.
INTELLIGENCE_MP_MODIFIER=100
